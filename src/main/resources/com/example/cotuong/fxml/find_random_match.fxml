<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="findRandomMatchPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.cotuong.controller.FindRandomMatchController"
           style="-fx-background-color: transparent;">
    <children>
        <VBox alignment="CENTER" spacing="15"
              style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-background-radius: 15; -fx-padding: 30;"
              maxWidth="450" maxHeight="500" minWidth="450">
            <effect>
                <DropShadow radius="10" color="#00000080"/>
            </effect>
            <children>
                <HBox alignment="CENTER" spacing="15">
                    <FontIcon iconLiteral="fas-random" iconSize="32" iconColor="#007bff"/>
                    <Text text="Tìm Trận Ngẫu Nhiên" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #333333;"/>
                </HBox>

                <!-- Error Notification Panel -->
                <HBox fx:id="errorNotificationPanel" alignment="CENTER_LEFT" spacing="5"
                      style="-fx-background-color: #f8d7da; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #f5c6cb; -fx-border-radius: 8; -fx-border-width: 1;"
                      visible="false" managed="false"
                      maxWidth="390" minWidth="390" prefWidth="390"
                      maxHeight="50" minHeight="50" prefHeight="50">
                    <FontIcon iconLiteral="fas-exclamation-triangle" iconSize="16" iconColor="#721c24"/>
                    <Text fx:id="errorMessageText" style="-fx-fill: #721c24; -fx-font-weight: bold; -fx-font-size: 14px"
                          wrappingWidth="350"
                          textAlignment="LEFT"/>
                </HBox>

                <VBox spacing="8" styleClass="form-group">
                    <Label text="Server" styleClass="form-label"/>
                    <TextField fx:id="ipField" promptText="Nhập IP server" styleClass="form-input"/>
                </VBox>

                <VBox spacing="8" styleClass="form-group">
                    <Label text="Tên người chơi" styleClass="form-label"/>
                    <TextField fx:id="playerNameField" promptText="Nhập tên của bạn" styleClass="form-input"/>
                </VBox>

                <VBox spacing="5" styleClass="form-group">
                    <Label text="Thời gian (phút/người chơi)" styleClass="form-label"/>
                    <ComboBox fx:id="timeSelectionComboBox" promptText="Chọn thời gian" styleClass="form-input" maxWidth="Infinity"/>
                </VBox>

                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="findMatchButton" styleClass="find-button" onAction="#handleFindMatch">
                        <graphic>
                            <HBox alignment="CENTER" spacing="10">
                                <FontIcon iconLiteral="fas-search" iconSize="20" iconColor="#ffffff"/>
                                <Text text="Tìm trận" style="-fx-fill: #ffffff;"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="cancelButton" styleClass="cancel-button" onAction="#handleCancel">
                        <graphic>
                            <HBox alignment="CENTER" spacing="10">
                                <FontIcon iconLiteral="fas-times-circle" iconSize="20" iconColor="#333333"/>
                                <Text text="Huỷ bỏ" style="-fx-fill: #333333;"/>
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>
            </children>
        </VBox>
    </children>
    <stylesheets>
        <URL value="@../css/find_random_match.css"/>
    </stylesheets>
</StackPane>