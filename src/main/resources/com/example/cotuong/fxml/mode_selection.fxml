<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.effect.DropShadow?>

<?import java.net.URL?>
<StackPane fx:id="modeSelectionPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.cotuong.controller.ModeSelectionController"
           style="-fx-background-color: rgba(0, 0, 0, 0.7);">
    <children>
        <VBox alignment="CENTER" spacing="20"
              style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 15; -fx-padding: 30;"
              maxWidth="500" maxHeight="400">
            <effect>
                <DropShadow radius="10" color="#00000080"/>
            </effect>
            <children>
                <Text text="Chọn Chế Độ Chơi" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #333333;"/>

                <Button fx:id="computerModeButton" styleClass="mode-button" onAction="#handleComputerMode">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <FontIcon iconLiteral="fas-robot" iconSize="30" iconColor="#333333"/>
                            <VBox alignment="CENTER_LEFT">
                                <Text text="Chơi với máy" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #333333;"/>
                                <Text text="Thách đấu với AI" style="-fx-font-size: 14px; -fx-fill: #666666;"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="twoPlayerModeButton" styleClass="mode-button" onAction="#handleTwoPlayerMode">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <FontIcon iconLiteral="fas-user-friends" iconSize="30" iconColor="#333333"/>
                            <VBox alignment="CENTER_LEFT">
                                <Text text="Hai người chơi" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #333333;"/>
                                <Text text="Chơi cùng máy tính" style="-fx-font-size: 14px; -fx-fill: #666666;"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="onlineModeButton" styleClass="mode-button" onAction="#handleOnlineMode">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <FontIcon iconLiteral="fas-globe" iconSize="30" iconColor="#333333"/>
                            <VBox alignment="CENTER_LEFT">
                                <Text text="Chơi trực tuyến" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #333333;"/>
                                <Text text="Đấu với người chơi khác" style="-fx-font-size: 14px; -fx-fill: #666666;"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="backButton" styleClass="back-button" onAction="#handleBackButton">
                    <graphic>
                        <HBox alignment="CENTER" spacing="10">
                            <FontIcon iconLiteral="fas-arrow-left" iconSize="18" iconColor="#333333"/>
                            <Text text="Quay lại" style="-fx-font-size: 16px; -fx-fill: #333333;"/>
                        </HBox>
                    </graphic>
                </Button>
            </children>
        </VBox>
    </children>
    <stylesheets>
        <URL value="@../css/mode_selection.css"/>
    </stylesheets>
</StackPane>