<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.layout.StackPane?>
        <?import javafx.scene.layout.VBox?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.text.Text?>
        <?import org.kordamp.ikonli.javafx.FontIcon?>
        <?import javafx.scene.effect.DropShadow?>
        <?import javafx.geometry.Insets?>
        <?import java.net.URL?>

<StackPane fx:id="pausePane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.cotuong.controller.PauseMenuController"
           style="-fx-background-color: rgba(0, 0, 0, 0.8); -fx-alignment: center;" visible="true">
    <children>
        <VBox alignment="CENTER" spacing="20" maxWidth="480" maxHeight="420"
              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, rgba(255, 255, 255, 0.95), rgba(245, 248, 252, 0.95));
                     -fx-background-radius: 20;
                     -fx-padding: 25 30 25 30;
                     -fx-border-color: rgba(255, 255, 255, 0.6);
                     -fx-border-width: 1;
                     -fx-border-radius: 20;">
            <effect>
                <DropShadow radius="25" color="rgba(0, 0, 0, 0.3)" offsetY="8"/>
            </effect>

            <children>
                <!-- Header -->
                <VBox alignment="CENTER" spacing="5">
                    <FontIcon iconLiteral="fas-pause" iconSize="32" iconColor="#4A90E2"/>
                    <Text text="Tạm Dừng Trò Chơi"
                          style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-fill: linear-gradient(from 0% 0% to 100% 100%, #2E5BBA, #4A90E2);"/>
                </VBox>

                <!-- Action Buttons -->
                <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20 0 0 0;">
                    <Button fx:id="resumeButton" onAction="#handleResume" styleClass="action-button" prefWidth="200">
                        <graphic>
                            <HBox alignment="CENTER" spacing="6">
                                <FontIcon iconLiteral="fas-play" iconSize="14" iconColor="#333333"/>
                                <Text text="Tiếp Tục" style="-fx-font-size: 14px; -fx-fill: #333333; -fx-font-weight: bold;"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="newGameButton" onAction="#handleNewGame" styleClass="action-button" prefWidth="200">
                        <graphic>
                            <HBox alignment="CENTER" spacing="6">
                                <FontIcon iconLiteral="fas-redo" iconSize="14" iconColor="#333333"/>
                                <Text text="Tạo Ván Chơi Mới" style="-fx-font-size: 14px; -fx-fill: #333333; -fx-font-weight: bold;"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="settingsButton" onAction="#handleSettings" styleClass="action-button" prefWidth="200">
                        <graphic>
                            <HBox alignment="CENTER" spacing="6">
                                <FontIcon iconLiteral="fas-cog" iconSize="14" iconColor="#333333"/>
                                <Text text="Cài Đặt" style="-fx-font-size: 14px; -fx-fill: #333333; -fx-font-weight: bold;"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="mainMenuButton" onAction="#handleMainMenu" styleClass="action-button" prefWidth="200">
                        <graphic>
                            <HBox alignment="CENTER" spacing="6">
                                <FontIcon iconLiteral="fas-home" iconSize="14" iconColor="#333333"/>
                                <Text text="Màn Hình Chính" style="-fx-font-size: 14px; -fx-fill: #333333; -fx-font-weight: bold;"/>
                            </HBox>
                        </graphic>
                    </Button>
                </VBox>
            </children>
        </VBox>
    </children>
    <stylesheets>
        <URL value="@../css/pause_menu.css"/>
    </stylesheets>
</StackPane>
