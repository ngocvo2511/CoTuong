<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.ListView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.effect.DropShadow?>
<?import java.net.URL?>

<StackPane fx:id="historyPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.cotuong.controller.HistoryController"
           style="-fx-background-color: transparent">
    <children>
        <VBox alignment="CENTER" spacing="20"
              style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 15; -fx-padding: 30;"
              maxWidth="700" maxHeight="550" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

            <effect>
                <DropShadow radius="10" color="#00000080"/>
            </effect>

            <children>
                <Text text="Lịch Sử Trận Đấu"
                      style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #333333;"/>

                <!-- Cho phép ListView đủ rộng và wrap text -->
                <ListView fx:id="historyList"
                          styleClass="history-list"
                          prefHeight="300"
                          prefWidth="600"
                          focusTraversable="false"/>

                <Button fx:id="backButton" styleClass="back-button" onAction="#handleCloseButton">
                    <graphic>
                        <HBox alignment="CENTER" spacing="10">
                            <FontIcon iconLiteral="fas-arrow-left" iconSize="18" iconColor="#333333"/>
                            <Text text="Quay lại" style="-fx-font-size: 16px; -fx-fill: #333333;"/>
                        </HBox>
                    </graphic>
                </Button>
            </children>
        </VBox>
    </children>
    <stylesheets>
        <URL value="@../css/history.css"/>
    </stylesheets>
</StackPane>