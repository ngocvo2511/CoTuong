<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Text?>

<?import java.net.URL?>

<?import javafx.scene.control.ListView?>
<VBox fx:id="historyPane" spacing="15" alignment="CENTER" styleClass="history-pane"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.cotuong.controller.HistoryController">
    <stylesheets>
        <URL value="@../css/history.css" />
    </stylesheets>
    <Text text="Lịch Sử Trận Đấu" styleClass="history-title" />
    <ListView fx:id="historyList" styleClass="history-list" prefHeight="400" prefWidth="300" />
    <HBox alignment="CENTER" spacing="10">
        <Button text="Đóng" onAction="#handleCloseButton" styleClass="close-button" />
    </HBox>
</VBox>