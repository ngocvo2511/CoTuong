<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.AnchorPane?>

<?import java.net.URL?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cotuong.controller.GameOverController"
            style="-fx-background-color: transparent;">
    <VBox alignment="CENTER" AnchorPane.topAnchor="0.0"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">

        <VBox alignment="CENTER" spacing="10.0"
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 10, 0, 0, 0);"
              maxWidth="600.0"
                prefHeight="350.0">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>

            <Label text="KẾT THÚC" style="-fx-font-weight: bold; -fx-text-fill: #8B4513;">
                <font>
                    <Font name="System Bold" size="32.0" />
                </font>
            </Label>

            <Label fx:id="winnerText" text="ĐỎ THẮNG!" style="-fx-font-weight: bold; -fx-text-fill: #FF0000;">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>

            <Label fx:id="reasonText" text="Đen bị chiếu bí" style="-fx-text-fill: #000000;">
                <font>
                    <Font size="18.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </Label>

            <HBox alignment="CENTER" spacing="15.0">
                <Button fx:id="newGameButton" onAction="#handleNewGame" text="Ván mới"
                        styleClass="new-game-button"
                        prefWidth="200.0" prefHeight="40.0">
                </Button>

                <Button fx:id="mainMenuButton" onAction="#handleMainMenu" text="Màn hình chính"
                        styleClass="main-menu-button"
                        prefWidth="200.0" prefHeight="40.0">
                </Button>

                <Button fx:id="replayButton" onAction="#handleReplay" text="Xem lại"
                        styleClass="replay-button"
                        prefWidth="200.0" prefHeight="40.0">
                </Button>
            </HBox>
        </VBox>
    </VBox>
    <stylesheets>
        <URL value="@../css/game_over.css"/>
    </stylesheets>
</AnchorPane>