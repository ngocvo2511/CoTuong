<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>
<StackPane fx:id="exitConfirmPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.cotuong.controller.ExitConfirmController"
           style="-fx-background-color: rgba(0, 0, 0, 0.8); -fx-alignment: center;" visible="true">
    <children>
        <VBox alignment="CENTER" spacing="20" maxWidth="400" maxHeight="300"
              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, rgba(255, 255, 255, 0.95), rgba(245, 248, 252, 0.95));
                     -fx-background-radius: 20;
                     -fx-padding: 25 30 25 30;
                     -fx-border-color: rgba(255, 255, 255, 0.6);
                     -fx-border-width: 1;
                     -fx-border-radius: 20;">
            <effect>
                <DropShadow radius="25" color="rgba(0, 0, 0, 0.3)" offsetY="8"/>
            </effect>

            <children>
                <!-- Header with Warning Icon -->
                <VBox alignment="CENTER" spacing="8">
                    <FontIcon iconLiteral="fas-exclamation-triangle" iconSize="36" iconColor="#FF6B6B"/>
                    <Text text="Xác Nhận Thoát Game"
                          style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-fill: linear-gradient(from 0% 0% to 100% 100%, #D63031, #FF6B6B);"/>
                </VBox>

                <!-- Confirmation Message -->
                <VBox alignment="CENTER" spacing="5" style="-fx-padding: 10 0 15 0;">
                    <Text text="Bạn có chắc chắn muốn thoát game?"
                          style="-fx-font-size: 16px; -fx-fill: #333333; -fx-text-alignment: center;"/>
                    <Text text="Tiến trình chơi hiện tại sẽ bị mất!"
                          style="-fx-font-size: 13px; -fx-fill: #666666; -fx-text-alignment: center; -fx-font-style: italic;"/>
                </VBox>

                <!-- Action Buttons -->
                <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="cancelButton" onAction="#handleCancel" styleClass="cancel-button" prefWidth="120">
                        <graphic>
                            <HBox alignment="CENTER" spacing="6">
                                <FontIcon iconLiteral="fas-times" iconSize="14" iconColor="#FFFFFF"/>
                                <Text text="Hủy Bỏ" style="-fx-font-size: 14px; -fx-fill: #FFFFFF; -fx-font-weight: bold;"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="confirmExitButton" onAction="#handleConfirmExit" styleClass="exit-button" prefWidth="120">
                        <graphic>
                            <HBox alignment="CENTER" spacing="6">
                                <FontIcon iconLiteral="fas-sign-out-alt" iconSize="14" iconColor="#FFFFFF"/>
                                <Text text="Thoát" style="-fx-font-size: 14px; -fx-fill: #FFFFFF; -fx-font-weight: bold;"/>
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>
            </children>
        </VBox>
    </children>
    <stylesheets>
        <URL value="@../css/exit_confirm.css"/>
    </stylesheets>
</StackPane>
