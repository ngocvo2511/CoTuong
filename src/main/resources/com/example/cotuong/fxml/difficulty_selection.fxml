<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.effect.DropShadow?>
<?import java.net.URL?>

<StackPane fx:id="difficultySelectionPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.cotuong.controller.DifficultySelectionController"
           style="-fx-background-color: transparent">
    <children>
        <VBox alignment="CENTER" spacing="20"
              style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 15; -fx-padding: 30;"
              maxWidth="450" maxHeight="400">
            <effect>
                <DropShadow radius="10" color="#00000080"/>
            </effect>
            <children>
                <Text text="Chọn Độ Khó" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #333333;"/>

                <Button fx:id="easyButton" styleClass="difficulty-button" onAction="#handleEasyMode">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <FontIcon iconLiteral="far-smile" iconSize="30" iconColor="#5cb85c"/>
                            <VBox alignment="CENTER_LEFT">
                                <Text text="Dễ" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #333333;"/>
                                <Text text="Phù hợp cho người mới bắt đầu" style="-fx-font-size: 14px; -fx-fill: #666666;"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="normalButton" styleClass="difficulty-button" onAction="#handleNormalMode">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <FontIcon iconLiteral="far-meh" iconSize="30" iconColor="#f0ad4e"/>
                            <VBox alignment="CENTER_LEFT">
                                <Text text="Thường" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #333333;"/>
                                <Text text="Cân bằng giữa thử thách và giải trí" style="-fx-font-size: 14px; -fx-fill: #666666;"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="hardButton" styleClass="difficulty-button" onAction="#handleHardMode">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <FontIcon iconLiteral="far-grimace" iconSize="30" iconColor="#d9534f"/>
                            <VBox alignment="CENTER_LEFT">
                                <Text text="Khó" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #333333;"/>
                                <Text text="Thách thức cho cao thủ" style="-fx-font-size: 14px; -fx-fill: #666666;"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="backButton" styleClass="back-button" onAction="#handleBackButton">
                    <graphic>
                        <HBox alignment="CENTER" spacing="10">
                            <FontIcon iconLiteral="fas-arrow-left" iconSize="18" iconColor="#333333"/>
                            <Text text="Quay lại" style="-fx-font-size: 16px; -fx-fill: #333333;"/>
                        </HBox>
                    </graphic>
                </Button>
            </children>
        </VBox>
    </children>
    <stylesheets>
        <URL value="@../css/difficulty_selection.css"/>
    </stylesheets>
</StackPane>