<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.Glow?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<StackPane fx:id="settingsPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.cotuong.controller.SettingsController"
           style="-fx-background-color: rgba(0, 0, 0, 0.8); -fx-cursor: hand;">
    <children>
        <VBox alignment="CENTER" spacing="20" maxWidth="480" maxHeight="420"
              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, rgba(255, 255, 255, 0.95), rgba(245, 248, 252, 0.95));
                     -fx-background-radius: 20;
                     -fx-padding: 25 30 25 30;
                     -fx-border-color: rgba(255, 255, 255, 0.6);
                     -fx-border-width: 1;
                     -fx-border-radius: 20;">
            <effect>
                <DropShadow radius="25" color="rgba(0, 0, 0, 0.3)" offsetY="8"/>
            </effect>

            <children>
                <fx:define>
                    <ToggleGroup fx:id="firstMoveGroup"/>
                </fx:define>

                <!-- Header -->
                <VBox alignment="CENTER" spacing="5">
                    <FontIcon iconLiteral="fas-cog" iconSize="32" iconColor="#4A90E2"/>
                    <Text text="Cài Đặt Trò Chơi"
                          style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-fill: linear-gradient(from 0% 0% to 100% 100%, #2E5BBA, #4A90E2);"/>
                </VBox>

                <!-- Time Settings Card -->
                <VBox spacing="10"
                      style="-fx-background-color: rgba(255, 255, 255, 0.8);
                             -fx-background-radius: 12;
                             -fx-padding: 15;
                             -fx-border-color: rgba(74, 144, 226, 0.3);
                             -fx-border-width: 1;
                             -fx-border-radius: 12;">
                    <effect>
                        <DropShadow radius="6" color="rgba(0, 0, 0, 0.1)" offsetY="2"/>
                    </effect>

                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <FontIcon iconLiteral="fas-clock" iconSize="20" iconColor="#4A90E2"/>
                        <Text text="Thời gian trận đấu:"
                              style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-fill: #333333;"/>
                        <TextField fx:id="timeInput" promptText="10"
                                   style="-fx-pref-width: 60; -fx-font-size: 17px;
                                         -fx-background-color: rgba(255, 255, 255, 0.9);
                                         -fx-background-radius: 6;
                                         -fx-border-color: rgba(74, 144, 226, 0.5);
                                         -fx-border-radius: 6;
                                         -fx-padding: 6 10;"/>
                        <Label text="phút" style="-fx-font-size: 17px; -fx-text-fill: #666666;"/>
                    </HBox>

                    <CheckBox fx:id="timeLimitCheckBox" text="Giới hạn thời gian"
                              style="-fx-font-size: 16px; -fx-text-fill: #555555;"/>
                </VBox>

                <!-- Volume Settings Card -->
                <HBox alignment="CENTER_LEFT" spacing="15"
                      style="-fx-background-color: rgba(255, 255, 255, 0.8);
                             -fx-background-radius: 12;
                             -fx-padding: 15;
                             -fx-border-color: rgba(74, 144, 226, 0.3);
                             -fx-border-width: 1;
                             -fx-border-radius: 12;">
                    <effect>
                        <DropShadow radius="6" color="rgba(0, 0, 0, 0.1)" offsetY="2"/>
                    </effect>

                    <FontIcon iconLiteral="fas-volume-up" iconSize="20" iconColor="#4A90E2"/>
                    <Slider fx:id="volumeSlider" min="0" max="100" value="50"
                            prefWidth="250"
                            style="-fx-background-color: transparent;"/>
                    <Label fx:id="volumeLabel" text="47"
                           style="-fx-font-size: 17px; -fx-text-fill: #333333; -fx-font-weight: bold; -fx-min-width: 25;"/>
                </HBox>

                <!-- First Move Settings Card -->
                <VBox spacing="15"
                      style="-fx-background-color: rgba(255, 255, 255, 0.8);
                             -fx-background-radius: 12;
                             -fx-padding: 15;
                             -fx-border-color: rgba(74, 144, 226, 0.3);
                             -fx-border-width: 1;
                             -fx-border-radius: 12;">
                    <effect>
                        <DropShadow radius="6" color="rgba(0, 0, 0, 0.1)" offsetY="2"/>
                    </effect>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconLiteral="fas-chess-pawn" iconSize="20" iconColor="#4A90E2"/>
                        <Text text="Lượt Đi Đầu Tiên"
                              style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-fill: #333333;"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="25">
                        <RadioButton fx:id="playerFirst" text="Tôi đi trước" selected="true"
                                     toggleGroup="$firstMoveGroup"
                                     style="-fx-font-size: 16px; -fx-text-fill: #333333;"/>
                        <RadioButton fx:id="aiFirst" text="Máy đi trước"
                                     toggleGroup="$firstMoveGroup"
                                     style="-fx-font-size: 16px; -fx-text-fill: #333333;"/>
                    </HBox>
                </VBox>

                <!-- Action Buttons -->
                <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="confirmButton" onAction="#confirmSelection"
                            style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #4A90E2, #357ABD);
                                   -fx-text-fill: white;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 20;
                                   -fx-padding: 10 25;
                                   -fx-cursor: hand;
                                   -fx-border-color: transparent;
                                   -fx-border-radius: 20;">
                        <graphic>
                            <HBox alignment="CENTER" spacing="6">
                                <FontIcon iconLiteral="fas-check-circle" iconSize="14" iconColor="white"/>
                                <Text text="Xác Nhận" style="-fx-font-size: 14px; -fx-fill: white; -fx-font-weight: bold;"/>
                            </HBox>
                        </graphic>
                        <effect>
                            <DropShadow radius="8" color="rgba(74, 144, 226, 0.4)" offsetY="3"/>
                        </effect>
                    </Button>

                    <Button fx:id="cancelButton" onAction="#cancelSelection"
                            style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #f8f9fa, #e9ecef);
                                   -fx-text-fill: #555555;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 20;
                                   -fx-padding: 10 25;
                                   -fx-cursor: hand;
                                   -fx-border-color: rgba(0, 0, 0, 0.2);
                                   -fx-border-width: 1;
                                   -fx-border-radius: 20;">
                        <graphic>
                            <HBox alignment="CENTER" spacing="6">
                                <FontIcon iconLiteral="fas-times-circle" iconSize="14" iconColor="#666666"/>
                                <Text text="Hủy Bỏ" style="-fx-font-size: 14px; -fx-fill: #555555; -fx-font-weight: bold;"/>
                            </HBox>
                        </graphic>
                        <effect>
                            <DropShadow radius="4" color="rgba(0, 0, 0, 0.1)" offsetY="1"/>
                        </effect>
                    </Button>
                </HBox>
            </children>
        </VBox>
    </children>
    <stylesheets>
        <URL value="@../css/settings.css"/>
    </stylesheets>
</StackPane>