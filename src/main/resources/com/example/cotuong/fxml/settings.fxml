<?xml version="1.0" encoding="UTF-8"?>
        <?import javafx.scene.layout.StackPane?>
        <?import javafx.scene.layout.VBox?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.control.Slider?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.text.Text?>
        <?import org.kordamp.ikonli.javafx.FontIcon?>
        <?import javafx.scene.effect.DropShadow?>
        <?import java.net.URL?>

<?import javafx.scene.control.CheckBox?>
<StackPane fx:id="settingsPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.cotuong.controller.SettingsController"
           style="-fx-background-color: rgba(0, 0, 0, 0.7);">
    <children>
        <VBox alignment="CENTER" spacing="20"
              style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 15; -fx-padding: 30;"
              maxWidth="500" maxHeight="400">
            <effect>
                <DropShadow radius="10" color="#00000080"/>
            </effect>
            <children>
                <Text text="Cài Đặt" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #333333;"/>
                <VBox alignment="CENTER" spacing="10">

                    <Text text="Thời gian trận đấu (phút)" style="-fx-font-size: 14px; -fx-fill: #666666;"/>
                    <TextField fx:id="timeInput" promptText="Nhập số phút" styleClass="time-input" />
                    <CheckBox fx:id="timeLimitCheckBox" text="Giới hạn thời gian" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="10">
                    <Text text="Âm lượng (%)" style="-fx-font-size: 14px; -fx-fill: #666666;"/>
                    <Slider fx:id="volumeSlider" min="0" max="100" value="50" majorTickUnit="25" minorTickCount="4" showTickLabels="true" showTickMarks="true" styleClass="volume-slider"/>
                </VBox>
                <VBox alignment="CENTER" spacing="10">
                    <Text text="Lượt đi đầu tiên" style="-fx-font-size: 14px; -fx-fill: #666666;"/>
                    <HBox alignment="CENTER" spacing="20">
                        <CheckBox fx:id="playerFirstCheckBox" text="Tôi đi trước" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
                        <CheckBox fx:id="aiFirstCheckBox" text="Máy đi trước" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
                    </HBox>
                </VBox>
                <HBox alignment="CENTER" spacing="15">
                    <Button fx:id="confirmButton" styleClass="confirm-button" onAction="#confirmSelection">
                        <graphic>
                            <HBox alignment="CENTER" spacing="10">
                                <FontIcon iconLiteral="fas-check" iconSize="18" iconColor="#333333"/>
                                <Text text="Xác Nhận" style="-fx-font-size: 16px; -fx-fill: #333333;"/>
                            </HBox>
                        </graphic>
                    </Button>
                    <Button fx:id="cancelButton" styleClass="back-button" onAction="#cancelSelection">
                        <graphic>
                            <HBox alignment="CENTER" spacing="10">
                                <FontIcon iconLiteral="fas-arrow-left" iconSize="18" iconColor="#333333"/>
                                <Text text="Hủy" style="-fx-font-size: 16px; -fx-fill: #333333;"/>
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>
            </children>
        </VBox>
    </children>
    <stylesheets>
        <URL value="@../css/settings.css"/>
    </stylesheets>
</StackPane>
