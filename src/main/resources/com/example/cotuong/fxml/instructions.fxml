<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Text?>

<?import java.net.URL?>
<VBox fx:id="instructionsPane" spacing="15" alignment="CENTER" styleClass="instructions-pane"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.cotuong.controller.InstructionsController">
    <stylesheets>
        <URL value="@../css/instructions.css" />
    </stylesheets>
    <Text text="LUẬT CHƠI" styleClass="instructions-title" />
    <TextArea fx:id="instructionsText" styleClass="instructions-text" editable="false" prefHeight="800" prefWidth="450" wrapText="true" />
    <HBox alignment="CENTER" spacing="10">
        <Button text="Đóng" onAction="#handleCloseButton" styleClass="close-button" />
    </HBox>
</VBox>