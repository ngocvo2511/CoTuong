<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.text.Text?>

<?import java.net.URL?>
<StackPane fx:id="difficultyPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cotuong.controller.DifficultySelectionController">
    <children>
        <StackPane style="-fx-background-color: rgba(255, 255, 255, 0.6); -fx-background-radius: 10;" maxWidth="600" maxHeight="400"/>
        <VBox alignment="CENTER" spacing="20">
            <children>
                <Text text="Chọn Mức Độ Khó" style="-fx-font-size: 50px; -fx-fill: black;"/>
                <Button fx:id="easyButton" text="Dễ" prefWidth="200" prefHeight="50" styleClass="mode-button" />
                <Button fx:id="mediumButton" text="Trung Bình" prefWidth="200" prefHeight="50" styleClass="mode-button"/>
                <Button fx:id="hardButton" text="Khó" prefWidth="200" prefHeight="50" styleClass="mode-button"/>
                <Button fx:id="backButton" text="Quay Lại" prefWidth="200" prefHeight="50" styleClass="mode-button" onAction="#handleBackButton"/>
            </children>
        </VBox>
    </children>
    <stylesheets>
        <URL value="@../css/main_menu.css"/>
    </stylesheets>
</StackPane>