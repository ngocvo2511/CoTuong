<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ProgressIndicator?>

<StackPane fx:id="waitingMatchPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.cotuong.controller.WaitingMatchController"
           style="-fx-background-color: rgba(0, 0, 0, 0.5);">
    <children>
        <VBox alignment="CENTER" spacing="20"
              style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-background-radius: 15; -fx-padding: 30;"
              maxWidth="400" maxHeight="300">
            <effect>
                <DropShadow radius="10" color="#00000080"/>
            </effect>
            <children>
                <HBox alignment="CENTER" spacing="15">
                    <FontIcon iconLiteral="fas-hourglass-half" iconSize="32" iconColor="#007bff"/>
                    <Text text="Đang Tìm Trận" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #333333;"/>
                </HBox>

                <ProgressIndicator prefWidth="70" prefHeight="70"/>

                <Label text="Vui lòng chờ trong giây lát..." style="-fx-font-size: 16px; -fx-text-fill: #555555;"/>

                <HBox alignment="CENTER" spacing="10">
                    <Label fx:id="playerInfoLabel" text="Người chơi: " style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
                    <Label fx:id="timeInfoLabel" text="Thời gian: " style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
                </HBox>

                <Button fx:id="cancelSearchButton" styleClass="cancel-button" onAction="#handleCancelSearch">
                    <graphic>
                        <HBox alignment="CENTER" spacing="10">
                            <FontIcon iconLiteral="fas-times-circle" iconSize="20" iconColor="#333333"/>
                            <Text text="Hủy Tìm Trận" style="-fx-fill: #333333;"/>
                        </HBox>
                    </graphic>
                </Button>
            </children>
        </VBox>
    </children>
    <stylesheets>
        <URL value="@../css/waiting_match.css"/>
    </stylesheets>
</StackPane>